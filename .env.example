# Contoh konfigurasi untuk docker compose.
# Copy ke .env lalu sesuaikan (docker compose otomatis membaca .env di folder ini).

# Password PostgreSQL (ubah untuk production!)
POSTGRES_PASSWORD=postgres

# URL API yang diakses BROWSER pengunjung.
# - Lokal: http://localhost:8000
# - VPS: http://<IP_VPS>:8000  atau  https://<domain> (jika lewat reverse proxy)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Asal yang diizinkan mengakses API (harus sama dengan asal frontend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
