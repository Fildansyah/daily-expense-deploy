# Contoh konfigurasi untuk docker compose.
# Copy ke .env lalu sesuaikan (docker compose otomatis membaca .env di folder ini).

# Password PostgreSQL (ubah untuk production!)
POSTGRES_PASSWORD=postgres

# URL API yang diakses BROWSER pengunjung. HARUS diakhiri /api
# (frontend menurunkan route public /public/* dari URL ini).
# - Lokal: http://localhost:8000/api (pakai "localhost", bukan 127.0.0.1,
#   agar cookie refresh same-site saat development)
# - VPS: https://<domain>/api (via reverse proxy Caddy, same-origin)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Asal yang diizinkan mengakses API (harus sama dengan asal frontend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Auth ---
# Di produksi nilai ini DIISI OTOMATIS oleh deploy.sh dari GitHub Actions secret
# bernama JWT_SECRET (lihat .github/workflows/deploy.yml). Jangan isi manual di VPS.
# Untuk development lokal, isi manual dengan: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
# true di VPS yang diakses via HTTPS, false untuk http lokal
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
